# Copy to .env.development for local development. docs/development/configuration.md
# describes every setting. Never commit a filled-in environment file.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5432/saudi_api
PUBLIC_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000
# Hostnames the MCP endpoint answers for, comma-separated; empty keeps localhost only.
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=
# Where reachability checks run from, shown with each result.
CHECK_REGION=local-development
LOG_LEVEL=INFO
