# Copy to /srv/saudi-api/.env.production on the VM, mode 600, and fill it in. Never commit
# the copy. docs/development/deployment.md is the procedure; docs/development/configuration.md
# describes the application settings. deploy/compose.yaml derives the public URLs and the
# MCP host from SITE_ADDRESS.

# The hostname the site answers on: a free DuckDNS subdomain until a domain is bought.
SITE_ADDRESS=example.duckdns.org
# Let's Encrypt account email, for expiry and policy notices.
ACME_EMAIL=
# A random database password: openssl rand -hex 32
POSTGRES_PASSWORD=

# Where reachability checks run from: oci-me-riyadh-1 or oci-me-jeddah-1.
CHECK_REGION=oci-me-riyadh-1
# Origins that may call /mcp from a browser. Empty allows none.
MCP_ALLOWED_ORIGINS=
LOG_LEVEL=INFO
